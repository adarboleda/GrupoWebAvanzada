                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"email\": \"juan.perez@example.com\",\n  \"fechaNacimiento\": \"1995-06-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/estudiantes",
