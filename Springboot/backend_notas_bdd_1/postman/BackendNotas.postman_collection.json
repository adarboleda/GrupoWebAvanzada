        {
          "name": "GET All Estudiantes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/estudiantes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "estudiantes"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is OK or No Content\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200,204]);",
                  "});",
                  "pm.test(\"Response is JSON when body present\", function () {",
                  "    if (pm.response.code === 200) pm.response.to.have.jsonBody();",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
